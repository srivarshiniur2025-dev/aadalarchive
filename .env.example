# ============================================================
# AadalArchive — Environment variables
# Copy to .env.local and fill in real values. Never commit secrets.
# ============================================================

# --- Supabase (required for auth + database + storage) ---
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only. NEVER expose to the browser / NEVER prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site URL used in auth emails / OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inspiration image search (server-only — never NEXT_PUBLIC_*) ---
# Unsplash: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# After editing keys, restart `next dev` / `next start` so the server reloads env.

# Optional: set to "true" only after enabling Google under
# Supabase → Authentication → Providers → Google
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
